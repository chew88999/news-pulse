{
  "name": "news-pulse",
  "version": "0.1.0",
  "private": true,
  "description": "Shows IT and engineering staff the three defence and technology news items that matter, with a check on whether each is true.",
  "type": "module",
  "scripts": {
    "opencode": "node --env-file-if-exists=.env scripts/opencode.mjs",
    "dev": "node --env-file-if-exists=.env --import tsx --watch server/index.ts",
    "start": "node --env-file-if-exists=.env --import tsx server/index.ts",
    "collect": "node --env-file-if-exists=.env --import tsx server/cli.ts collect",
    "refresh": "node --env-file-if-exists=.env --import tsx server/cli.ts refresh",
    "selftest": "node --env-file-if-exists=.env --import tsx server/selftest/run.ts",
    "typecheck": "tsc --noEmit"
  },
  "engines": {
    "node": ">=22"
  },
  "dependencies": {
    "@hono/node-server": "^2.1.5",
    "@opencode-ai/sdk": "^1.19.3",
    "hono": "^4.13.13",
    "node-cron": "^4.6.0",
    "rss-parser": "^3.13.0",
    "undici": "^8.12.3",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/node": "^26.6.5",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2"
  }
}
