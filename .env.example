# Copy to .env and fill in. Never commit .env.

# OpenCode Go API key (from https://opencode.ai/console)
OPENCODE_GO_API_KEY=

# Model OpenCode uses, as provider/model (see README for options)
OPENCODE_MODEL=opencode-go/kimi-k3

# Protects the OpenCode server with HTTP basic auth (username defaults to "opencode")
OPENCODE_SERVER_PASSWORD=change-me
OPENCODE_SERVER_USERNAME=opencode
OPENCODE_URL=http://127.0.0.1:4096

# Backend
PORT=3000
# Cron for refreshing the top three (default: every 2 hours)
REFRESH_CRON=0 */2 * * *
# How many candidates the agent validates per refresh (cost control)
MAX_VALIDATE=8
# Only consider articles newer than this many hours
MAX_AGE_HOURS=48
