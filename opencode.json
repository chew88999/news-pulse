{
  "$schema": "https://opencode.ai/config.json",
  "model": "{env:OPENCODE_MODEL}",
  "enabled_providers": ["opencode-go"],
  "provider": {
    "opencode-go": {
      "options": {
        "apiKey": "{env:OPENCODE_GO_API_KEY}"
      }
    }
  },
  "permission": {
    "skill": {
      "*": "deny",
      "defence-tech-news": "allow"
    }
  },
  "share": "disabled",
  "autoupdate": false
}
